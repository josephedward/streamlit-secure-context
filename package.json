{
  "name": "secure-ai-notes",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bash run-app.sh",
    "test": "node --test",
    "test:e2e": "playwright test",
    "screenshots": "node screenshot.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "cypress": "^12.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^22.1.0",
    "puppeteer": "^20.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/src/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/",
      "<rootDir>/cypress/"
    ]
  },
  "dependencies": {
    "vercel": "^41.7.3"
  }
}
